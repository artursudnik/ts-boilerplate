{
  "name": "ts-boilerplate",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "generate-barrels": "barrelsby --config barrelsby.config.json",
    "lint": "eslint_d \"**/*.ts\"",
    "prepare": "husky",
    "prettier:check": "prettier -c .",
    "prettier:write": "prettier -w .",
    "start:dev": "pnpm tsx watch --clear-screen=false --include src src/index.ts",
    "test": "jest"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "barrelsby": "2.8.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint_d": "15.0.3",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.5.1",
    "organize-imports-cli": "1.0.2",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.13",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "packageManager": "pnpm@12.7.0+sha512.9c56477e360068d6e9dca6a92efb4e46b3dc5a52fcebf3d84d78b9736c0ded589a561621a52f68219a7a39facc63cdc079c3226ef9c9d5f02b79f74e69a807b6",
  "engines": {
    "node": "24",
    "npm": "use yarn",
    "yarn": "1"
  },
  "engineStrict": true
}
