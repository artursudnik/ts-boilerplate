{
  "name": "ts-boilerplate",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "generate-barrels": "barrelsby --config barrelsby.config.json",
    "lint": "eslint_d \"**/*.ts\"",
    "lint:ci": "eslint \"**/*.ts\"",
    "prepare": "husky",
    "prettier:check": "prettier -c .",
    "prettier:write": "prettier -w .",
    "start:dev": "pnpm tsx watch --clear-screen=false --include src src/index.ts",
    "test": "jest"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "barrelsby": "2.8.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint_d": "15.0.3",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.0.3",
    "rimraf": "6.1.4",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": "26",
    "pnpm": ">=12"
  },
  "engineStrict": true
}
