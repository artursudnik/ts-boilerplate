{
  "name": "ts-boilerplate",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "generate-barrels": "barrelsby --config barrelsby.config.json",
    "lint": "eslint_d \"**/*.ts\"",
    "lint:ci": "eslint \"**/*.ts\"",
    "prepare": "husky",
    "prettier:check": "prettier -c .",
    "prettier:write": "prettier -w .",
    "start:dev": "pnpm tsx watch --clear-screen=false --include src src/index.ts",
    "test": "jest"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "barrelsby": "2.8.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint_d": "15.0.3",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.0.2",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "packageManager": "pnpm@12.13.0+sha512.1e55719bf26e809dce5c5084fdebaa64efb3da9038ae5d68a9f8a68311f1a45841c8c3b76a37298c3b66f6bcc80409a9b7f33c78a7168a3e90fb65a5d8235ae4",
  "engines": {
    "node": "24",
    "pnpm": ">=12"
  },
  "engineStrict": true
}
